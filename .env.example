APP_NAME="Ugur Bakkal"
APP_ENV=local
APP_DEBUG=true
APP_KEY=SomeRandomString

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carta
DB_USERNAME=carta
DB_PASSWORD=secret

# Read-only mode for the whole site, so demo credentials are safe to publish.
DEMO_MODE=false

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Only needed if CACHE_DRIVER is set to redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 'log' writes mail to storage/logs instead of sending it
MAIL_DRIVER=log
MAIL_HOST=mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# Temporary product image lifetime in minutes
PRODUCT_TEMP_IMAGE_LIFETIME=60

# Catalog path (root is /public)
CATALOG_PATH=/catalog
